[Unit]
Description=Virtual Dataset (360 Pano CCTV ReID) - FastAPI + built SPA
After=network.target

[Service]
Type=simple
# 배포 위치와 실행 계정에 맞게 수정하세요.
User=virtualds
Group=virtualds
WorkingDirectory=/opt/virtual_dataset
# venv 안의 uvicorn 사용. --reload 는 프로덕션에서 쓰지 않음.
# 단일 워커: YOLOv8(torch) 모델이 워커마다 메모리를 크게 잡으므로 사내 도구엔 1개 권장.
ExecStart=/opt/virtual_dataset/.venv/bin/python -m uvicorn server.app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# ffmpeg 가 PATH 에 있어야 /api/detect(webm→mp4) 가 동작함.
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/virtual_dataset/.venv/bin

[Install]
WantedBy=multi-user.target
